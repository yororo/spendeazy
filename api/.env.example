# Optional; sets the runtime environment and defaults to development.
NODE_ENV=development

# Optional; sets the HTTP server port and defaults to 3000.
PORT=3000

# Required in production; PostgreSQL connection URL used by TypeORM/database access.
DATABASE_URL=postgresql://spendeazy_user:spendeazy_password@localhost:5432/spendeazydb

# Required in production; comma-separated explicit HTTP(S) origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Required in production; Clerk PEM public key used for networkless session-token verification.
# Literal \n sequences are converted to newlines for single-line environment values.
CLERK_JWT_KEY=

# Required in production; Clerk secret key used for authoritative profile retrieval.
CLERK_SECRET_KEY=

# Required in production; comma-separated frontend origins allowed in Clerk azp claims.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Required in production; 32-byte hexadecimal key used to protect stored Invite Codes.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INVITATION_CODE_ENCRYPTION_KEY=

# External HTTP endpoint that accepts Shared Space archive notification emails.
# If unset, in-app notifications are retained with failed email delivery.
SPACE_NOTIFICATION_DELIVERY_URL=

# Optional; bearer credential for the configured notification delivery endpoint.
SPACE_NOTIFICATION_DELIVERY_API_KEY=
