# Optional; sets the runtime environment and defaults to development.
NODE_ENV=development

# Optional; sets the HTTP server port and defaults to 3000.
PORT=3000

# Local manual database from the root compose.yaml; use separate deployment settings in production.
DATABASE_URL=postgresql://spendeazy:spendeazy_local_only@127.0.0.1:55433/spendeazy_disposable_manual

# Required for authenticated local testing and production; Clerk PEM public key used for networkless session-token verification.
# Literal \n sequences are converted to newlines for single-line environment values.
CLERK_JWT_KEY=

# Required for authenticated local testing and production; Clerk secret key used for authoritative profile retrieval.
CLERK_SECRET_KEY=

# Required whenever DATABASE_URL is configured; stable 32-byte hexadecimal key used to protect stored Invite Codes.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
INVITATION_CODE_ENCRYPTION_KEY=

# Required whenever DATABASE_URL is configured; dedicated stable 32-byte key for GCash reference HMACs.
GCASH_REFERENCE_HASH_KEY=
