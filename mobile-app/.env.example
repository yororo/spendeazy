# Origin of a dedicated development API reachable from the target device.
# Android emulator on the development computer: http://10.0.2.2:3000
# Physical device: use a trusted LAN address or HTTPS development endpoint.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Clerk publishable key for the development instance. Never commit a secret key.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Native Google sign-in client IDs. These are public client identifiers, not secrets.
# The iOS URL scheme is the iOS client id before ".apps.googleusercontent.com",
# prefixed with com.googleusercontent.apps.
# WEB_CLIENT_ID is the web-type OAuth client Clerk's native Google sign-in requires as the
# server/token audience (same one configured in the Clerk dashboard). No web app is involved.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=
