{
  "expo": {
    "name": "spendeazy-mobile",
    "slug": "spendeazy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spendeazymobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.seyfsasy.spendeazymobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.seyfsasy.spendeazymobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "./plugins/with-parser-proof-object-paths",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7FC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "@clerk/expo-google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo from your library.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7ff8723e-d3a3-4a26-8479-6ed3cff40dd7"
      }
    }
  }
}
